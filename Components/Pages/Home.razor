@page "/"
@implements IDisposable
@inject ServerInstanceManager InstanceManager
@inject AddonService AddonService
@inject AuthStateService AuthState

<PageTitle>MCWS v2 - 서버 대시보드</PageTitle>

@if (!AuthState.IsLoggedIn || AuthState.CurrentUser == null)
{
    <div class="mcws-alert mcws-alert-warning mt-4">
        마인크래프트 서버 대시보드를 이용하려면 먼저 <a href="/login" style="color: var(--mcws-primary); font-weight: bold;">로그인</a>해주세요.
    </div>
}
else
{
    <div class="py-3">
        <!-- 1. 상단 호스트 RAM 실시간 예약 모니터링 바 -->
        <div class="mcws-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold" style="color: var(--mcws-primary);">호스트 RAM 예약 할당 현황</span>
                <button class="btn-mcws-secondary btn-mcws-sm" @onclick="HandleManualRefreshAsync" disabled="@_isRefreshing">
                    <span class="mcws-spinner @(_isRefreshing ? "mcws-spinner-spin" : "")"></span>상태 새로고침
                </button>
            </div>
            <div class="d-flex flex-wrap justify-content-between small mb-2" style="color: var(--mcws-text-secondary);">
                <span>전체 물리 RAM: <strong>@_ram.TotalRamGb GB</strong></span>
                <span>OS 및 외부 사용량: <strong>@_ram.SystemUsedRamGb GB</strong></span>
                <span>마크 서버 예약(-Xmx): <strong>@_ram.ReservedMcRamGb GB</strong></span>
                <span style="color: var(--mcws-primary);">안전 가용 RAM: <strong>@_ram.SafeAvailableRamGb GB</strong></span>
            </div>
            <div class="mcws-progress">
                <div class="mcws-progress-bar" style="width: @(GetUsedRamPercent())%;"></div>
            </div>
        </div>

        @if (_resultCode != null)
        {
            <div class="mcws-alert @(_isError ? "mcws-alert-danger" : "mcws-alert-success")">
                @_resultCode.Value.ToMessage()
            </div>
        }

        <!-- 2. 다중 서버 슬롯 3개 (Slot 1 ~ 3) -->
        <div class="row g-4">
            @for (int slot = 1; slot <= 3; slot++)
            {
                int currentSlot = slot;
                var instance = _instances.FirstOrDefault(x => x.SlotNumber == currentSlot);

                <div class="col-lg-4">
                    <div class="mcws-card h-100 d-flex flex-column justify-content-between">
                        @if (instance != null)
                        {
                            <div>
                                <div class="mcws-card-header">
                                    <h5 class="mcws-card-title">슬롯 @currentSlot — @instance.Name</h5>
                                    <span class="mcws-badge @GetBadgeClass(instance.Status)">@instance.Status</span>
                                </div>
                                <div class="small mb-3" style="color: var(--mcws-text-secondary); line-height: 1.7;">
                                    <div>포트(Port): <strong>@instance.Port</strong></div>
                                    <div>할당 RAM: <strong>@instance.AllocatedRamGb GB</strong> (-Xmx@(instance.AllocatedRamGb)G)</div>
                                    <div>버킷 파일: <strong>@instance.JarFileName</strong></div>
                                    <div>실행 환경: <strong>Java @instance.JavaVersion / @instance.LoaderType</strong></div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @if (instance.Status == ServerStatus.Offline)
                                {
                                    <button class="btn-mcws-primary btn-mcws-sm flex-grow-1"
                                            @onclick="() => HandleStartAsync(instance.Id)">서버 시작</button>
                                    <button class="btn-mcws-danger btn-mcws-sm"
                                            @onclick="() => HandleDeleteAsync(instance.Id)">삭제</button>
                                }
                                else if (instance.Status == ServerStatus.Running || instance.Status == ServerStatus.Starting)
                                {
                                    <button class="btn-mcws-danger btn-mcws-sm flex-grow-1"
                                            @onclick="() => HandleStopAsync(instance.Id)">안전 종료 (Stop)</button>
                                }
                                <button class="@(_selectedInstance?.Id == instance.Id ? "btn-mcws-primary" : "btn-mcws-secondary") btn-mcws-sm w-100"
                                        @onclick="() => SelectSlot(instance)">
                                    @(_selectedInstance?.Id == instance.Id ? "콘솔 / 설정 / 월드 제어 (닫기)" : "콘솔 / 설정 / 월드 제어")
                                </button>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="mcws-card-header">
                                    <h5 class="mcws-card-title">슬롯 @currentSlot (비어 있음)</h5>
                                    <span class="mcws-badge badge-offline">Port @(25564 + currentSlot)</span>
                                </div>

                                <div class="mb-2">
                                    <label class="mcws-label">서버 이름</label>
                                    <input class="mcws-input" placeholder="예: 야생 서버" @bind="_newNames[currentSlot]" />
                                </div>
                                <div class="mb-2">
                                    <label class="mcws-label">할당 RAM (GB)</label>
                                    <select class="mcws-select" @bind="_newRams[currentSlot]">
                                        <option value="2">2 GB</option>
                                        <option value="4">4 GB</option>
                                        <option value="8">8 GB</option>
                                        <option value="12">12 GB</option>
                                        <option value="16">16 GB</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="mcws-label">사용할 버킷 템플릿 (.jar)</label>
                                    <select class="mcws-select" @bind="_newTemplates[currentSlot]">
                                        <option value="0">-- 보관소 버킷 선택 --</option>
                                        @foreach (var t in _templates)
                                        {
                                            <option value="@t.Id">@t.FileName (Java @t.RecommendedJavaVersion)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <button class="btn-mcws-primary w-100" @onclick="() => HandleCreateSlotAsync(currentSlot)">
                                슬롯 @currentSlot 생성하기
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 3. 선택된 슬롯의 하단 상세 제어 패널 (분리된 컴포넌트) -->
        @if (_selectedInstance != null)
        {
            <SlotControlPanel Instance="_selectedInstance"
                              Logs="InstanceManager.GetLogs(_selectedInstance.Id)" />
        }
    </div>
}

@code {
    private List<ServerInstance> _instances = new();
    private List<ServerTemplate> _templates = new();
    private RamMetrics _ram;
    private ServerInstance? _selectedInstance;
    private ResultCode? _resultCode;
    private bool _isError;
    private bool _isRefreshing;

    private readonly Dictionary<int, string> _newNames = new() { [1] = "", [2] = "", [3] = "" };
    private readonly Dictionary<int, int> _newRams = new() { [1] = 4, [2] = 4, [3] = 4 };
    private readonly Dictionary<int, int> _newTemplates = new() { [1] = 0, [2] = 0, [3] = 0 };

    protected override async Task OnInitializedAsync()
    {
        InstanceManager.OnLogBroadcast += HandleLogBroadcast;
        InstanceManager.OnStatusBroadcast += HandleStatusBroadcast;
        await RefreshDashboardAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        _instances = await InstanceManager.GetServerInstancesAsync();
        _templates = await AddonService.GetServerTemplatesAsync();
        _ram = InstanceManager.GetCurrentRamMetrics();

        if (_selectedInstance != null)
            _selectedInstance = _instances.FirstOrDefault(x => x.Id == _selectedInstance.Id);
    }

    private async Task HandleManualRefreshAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        StateHasChanged();

        var minSpinTask = Task.Delay(500);
        await RefreshDashboardAsync();
        await minSpinTask;

        _isRefreshing = false;
    }

    private void SelectSlot(ServerInstance instance)
    {
        if (_selectedInstance?.Id == instance.Id)
            _selectedInstance = null;
        else
            _selectedInstance = instance;
    }

    private double GetUsedRamPercent()
    {
        if (_ram.TotalRamGb <= 0) return 0;
        double used = _ram.TotalRamGb - _ram.SafeAvailableRamGb;
        return Math.Clamp(Math.Round((used / _ram.TotalRamGb) * 100.0, 1), 0, 100);
    }

    private string GetBadgeClass(ServerStatus status) => status switch
    {
        ServerStatus.Running => "badge-running",
        ServerStatus.Starting or ServerStatus.Stopping => "badge-starting",
        _ => "badge-offline"
    };

    private async Task HandleCreateSlotAsync(int slotNumber)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await InstanceManager.CreateServerInstanceAsync(
            slotNumber, _newNames[slotNumber], _newRams[slotNumber], _newTemplates[slotNumber], AuthState.CurrentUser.Username);

        _isError = !success;
        _resultCode = code;
        if (success) _newNames[slotNumber] = string.Empty;
        await RefreshDashboardAsync();
    }

    private async Task HandleStartAsync(int instanceId)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await InstanceManager.StartServerAsync(instanceId, AuthState.CurrentUser.Username);
        _isError = !success;
        _resultCode = code;
        await RefreshDashboardAsync();
    }

    private async Task HandleStopAsync(int instanceId)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await InstanceManager.StopServerAsync(instanceId, AuthState.CurrentUser.Username);
        _isError = !success;
        _resultCode = code;
        await RefreshDashboardAsync();
    }

    private async Task HandleDeleteAsync(int instanceId)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await InstanceManager.DeleteInstanceAsync(instanceId, AuthState.CurrentUser.Username);
        _isError = !success;
        _resultCode = code;
        if (success && _selectedInstance?.Id == instanceId) _selectedInstance = null;
        await RefreshDashboardAsync();
    }

    private void HandleLogBroadcast(int instanceId, ConsoleLogLine line)
    {
        if (_selectedInstance?.Id == instanceId)
            _ = InvokeAsync(StateHasChanged);
    }

    private void HandleStatusBroadcast(int instanceId, ServerStatus status)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshDashboardAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        InstanceManager.OnLogBroadcast -= HandleLogBroadcast;
        InstanceManager.OnStatusBroadcast -= HandleStatusBroadcast;
    }
}
