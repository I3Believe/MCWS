@page "/storage"
@inject AddonService AddonService
@inject AuthStateService AuthState

<PageTitle>MCWS v2 - 보관소 관리</PageTitle>

@if (!AuthState.IsLoggedIn || AuthState.CurrentUser == null)
{
    <div class="mcws-alert mcws-alert-warning mt-4">
        로그인 후 이용할 수 있습니다.
    </div>
}
else
{
    <div class="py-3">
        <h4 class="fw-bold mb-3" style="color: var(--mcws-primary);">공용 템플릿 및 애드온 보관소</h4>

        @if (_resultCode != null)
        {
            <div class="mcws-alert @(_isError ? "mcws-alert-danger" : "mcws-alert-success")">
                @_resultCode.Value.ToMessage()
            </div>
        }

        <!-- 상단 탭 선택 (버킷 / 월드 / 플러그인 / 모드) -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="@(_activeTab == "jars" ? "btn-mcws-primary" : "btn-mcws-secondary")"
                    @onclick='() => SwitchTab("jars")'>
                서버 버킷 (.jar) (@_templates.Count)
            </button>
            <button class="@(_activeTab == "world" ? "btn-mcws-primary" : "btn-mcws-secondary")"
                    @onclick='() => SwitchTab("world")'>
                월드 맵 (.zip) (@_addons.Count(a => a.Type == AddonType.World))
            </button>
            <button class="@(_activeTab == "plugin" ? "btn-mcws-primary" : "btn-mcws-secondary")"
                    @onclick='() => SwitchTab("plugin")'>
                플러그인 (.jar) (@_addons.Count(a => a.Type == AddonType.Plugin))
            </button>
            <button class="@(_activeTab == "mod" ? "btn-mcws-primary" : "btn-mcws-secondary")"
                    @onclick='() => SwitchTab("mod")'>
                모드 (.jar) (@_addons.Count(a => a.Type == AddonType.Mod))
            </button>
        </div>

        <!-- 1. 파일 업로드 카드 -->
        <div class="mcws-card mb-4">
            <div class="mcws-card-header">
                <h5 class="mcws-card-title">새 파일 업로드 (@GetTabDisplayName())</h5>
            </div>

            <div class="row g-3 align-items-end">
                <div class="@(_activeTab == "jars" ? "col-md-5" : "col-md-9")">
                    <label class="mcws-label">파일 선택 @( _activeTab == "world" ? "(.zip)" : "(.jar)" ) — 동일 파일명 업로드 시 자동 갱신</label>
                    <InputFile @key="_inputFileKey"
                               OnChange="HandleFileSelected"
                               accept="@(_activeTab == "world" ? ".zip" : ".jar")"
                               class="mcws-input" />
                </div>

                @if (_activeTab == "jars")
                {
                    <div class="col-md-3">
                        <label class="mcws-label">권장 Java 버전 (자동 감지됨)</label>
                        <select class="mcws-select" @bind="_selectedJavaVersion">
                            <option value="25">Java 25 (MC 26.1 이상)</option>
                            <option value="21">Java 21 (MC 1.20.5 ~ 1.21.x)</option>
                            <option value="17">Java 17 (MC 1.17 ~ 1.20.4)</option>
                            <option value="8">Java 8 (MC 1.16.5 이하)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="mcws-label">로더 유형 (자동 감지됨)</label>
                        <select class="mcws-select" @bind="_selectedLoaderType">
                            <option value="@ServerLoaderType.PluginOnly">PluginOnly (Paper/Spigot)</option>
                            <option value="@ServerLoaderType.ModOnly">ModOnly (Forge/Fabric)</option>
                            <option value="@ServerLoaderType.Hybrid">Hybrid (Arclight/Mohist)</option>
                        </select>
                    </div>
                }

                <div class="@(_activeTab == "jars" ? "col-md-2" : "col-md-3")">
                    <button class="btn-mcws-primary w-100"
                            @onclick="HandleUploadSubmitAsync"
                            disabled="@(_selectedFile == null || _isUploading)">
                        @(_isUploading ? "업로드 중..." : "업로드")
                    </button>
                </div>
            </div>

            @if (_selectedFile != null && !_isUploading)
            {
                <div class="small mt-2" style="color: var(--mcws-text-secondary);">
                    선택된 파일: <strong>@_selectedFile.Name</strong> (@FormatSizeMb(_selectedFile.Size) MB)
                    @if (_activeTab == "jars")
                    {
                        <span> — 감지된 설정: <strong>Java @_selectedJavaVersion / @_selectedLoaderType</strong> (우측의 [업로드] 버튼을 누르면 저장됩니다)</span>
                    }
                    else
                    {
                        <span> — 우측의 [업로드] 버튼을 누르면 보관소에 저장됩니다.</span>
                    }
                </div>
            }

            @if (_isUploading)
            {
                <div class="small mt-2" style="color: var(--mcws-primary);">
                    파일을 디스크에 안전하게 기록하는 중입니다...
                </div>
            }
        </div>

        <!-- 2. 보관소 파일 목록 테이블 (단일 통합 테이블) -->
        <div class="mcws-card">
            <div class="mcws-card-header">
                <h5 class="mcws-card-title">@GetTabDisplayName() 목록</h5>
            </div>

            <div class="mcws-table-container">
                <table class="mcws-table">
                    <thead>
                        <tr>
                            <th>파일명</th>
                            @if (_activeTab == "jars")
                            {
                                <th>권장 Java</th>
                                <th>로더 유형</th>
                            }
                            <th>크기 (MB)</th>
                            <th>업로드 일시</th>
                            <th class="text-end">다운로드 / 삭제</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_activeTab == "jars")
                        {
                            @foreach (var t in _templates)
                            {
                                <tr>
                                    <td class="fw-bold">@t.FileName</td>
                                    <td><span class="mcws-badge badge-offline">Java @t.RecommendedJavaVersion</span></td>
                                    <td><span class="mcws-badge badge-running">@t.LoaderType</span></td>
                                    <td>@FormatSizeMb(t.FileSizeBytes) MB</td>
                                    <td class="small">@t.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-end">
                                        <a href="/download/jars/@t.FileName" class="btn-mcws-secondary btn-mcws-sm me-1" style="text-decoration: none;" download>다운로드</a>
                                        <button class="btn-mcws-danger btn-mcws-sm" @onclick="() => HandleDeleteTemplateAsync(t.Id)">삭제</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            var currentType = GetCurrentAddonType();
                            var categoryUrl = currentType == AddonType.World ? "maps" : currentType == AddonType.Plugin ? "plugins" : "mods";
                            @foreach (var a in _addons.Where(x => x.Type == currentType))
                            {
                                <tr>
                                    <td class="fw-bold">@a.FileName</td>
                                    <td>@FormatSizeMb(a.FileSizeBytes) MB</td>
                                    <td class="small">@a.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-end">
                                        <a href="/download/@categoryUrl/@a.FileName" class="btn-mcws-secondary btn-mcws-sm me-1" style="text-decoration: none;" download>다운로드</a>
                                        <button class="btn-mcws-danger btn-mcws-sm" @onclick="() => HandleDeleteAddonAsync(a.Id)">삭제</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private const long MaxUploadSize = 1024L * 1024L * 500L; // 최대 500MB
    private string _activeTab = "jars";
    private int _selectedJavaVersion = 21;
    private ServerLoaderType _selectedLoaderType = ServerLoaderType.PluginOnly;
    private IBrowserFile? _selectedFile;
    private int _inputFileKey;
    private bool _isUploading;
    private ResultCode? _resultCode;
    private bool _isError;

    private List<ServerTemplate> _templates = new();
    private List<AddonFile> _addons = new();

    protected override async Task OnInitializedAsync() => await LoadStorageAsync();

    private async Task LoadStorageAsync()
    {
        _templates = await AddonService.GetServerTemplatesAsync();
        _addons = await AddonService.GetAddonFilesAsync();
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
        _selectedFile = null;
        _inputFileKey++;
        _resultCode = null;
    }

    private AddonType GetCurrentAddonType() => _activeTab switch
    {
        "world" => AddonType.World,
        "plugin" => AddonType.Plugin,
        _ => AddonType.Mod
    };

    private string GetTabDisplayName() => _activeTab switch
    {
        "jars" => "서버 버킷 (.jar)",
        "world" => "월드 맵 (.zip)",
        "plugin" => "플러그인 (.jar)",
        _ => "모드 (.jar)"
    };

    private double FormatSizeMb(long bytes) => Math.Round(bytes / (1024.0 * 1024.0), 2);

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _resultCode = null;

        if (_activeTab == "jars" && _selectedFile != null)
        {
            string lower = _selectedFile.Name.ToLowerInvariant();

            // 파일명 기반 권장 Java 버전 자동 추론
            if (lower.Contains("1.7") || lower.Contains("1.8") || lower.Contains("1.12") || lower.Contains("1.16"))
                _selectedJavaVersion = 8;
            else if (lower.Contains("1.17") || lower.Contains("1.18") || lower.Contains("1.19") || lower.Contains("1.20.1") || lower.Contains("1.20.2") || lower.Contains("1.20.4"))
                _selectedJavaVersion = 17;
            else if (lower.Contains("1.20") || lower.Contains("1.21"))
                _selectedJavaVersion = 21;
            else
                _selectedJavaVersion = 25;

            // 파일명 기반 로더 유형 자동 추론
            if (lower.Contains("mohist") || lower.Contains("arclight") || lower.Contains("magma") || lower.Contains("catserver"))
                _selectedLoaderType = ServerLoaderType.Hybrid;
            else if (lower.Contains("forge") || lower.Contains("neoforge") || lower.Contains("fabric") || lower.Contains("quilt"))
                _selectedLoaderType = ServerLoaderType.ModOnly;
            else
                _selectedLoaderType = ServerLoaderType.PluginOnly;
        }
    }

    private async Task HandleUploadSubmitAsync()
    {
        if (_selectedFile == null || AuthState.CurrentUser == null) return;
        _isUploading = true;
        _resultCode = null;

        try
        {
            await using var stream = _selectedFile.OpenReadStream(MaxUploadSize);
            var (success, code) = _activeTab == "jars"
                ? await AddonService.UploadServerTemplateAsync(_selectedFile.Name, stream, _selectedJavaVersion, _selectedLoaderType, AuthState.CurrentUser.Username)
                : await AddonService.UploadAddonFileAsync(_selectedFile.Name, stream, GetCurrentAddonType(), AuthState.CurrentUser.Username);

            _isError = !success;
            _resultCode = code;
            if (success)
            {
                _selectedFile = null;
                _inputFileKey++;
            }
            await LoadStorageAsync();
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task HandleDeleteTemplateAsync(int id)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await AddonService.DeleteServerTemplateAsync(id, AuthState.CurrentUser.Username);
        _isError = !success;
        _resultCode = code;
        await LoadStorageAsync();
    }

    private async Task HandleDeleteAddonAsync(int id)
    {
        if (AuthState.CurrentUser == null) return;
        var (success, code) = await AddonService.DeleteAddonFileAsync(id, AuthState.CurrentUser.Username);
        _isError = !success;
        _resultCode = code;
        await LoadStorageAsync();
    }
}
