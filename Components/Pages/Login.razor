@page "/login"
@implements IDisposable
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>MCWS v2 - 로그인 및 회원가입</PageTitle>

<div class="container py-5" style="max-width: 440px;">
    <div class="mcws-card">
        <div class="mcws-card-header justify-content-center">
            <h4 class="mcws-card-title" style="color: var(--mcws-primary);">MCWS 계정 센터</h4>
        </div>

        @if (AuthState.IsLoggedIn && AuthState.CurrentUser != null)
        {
            <div class="text-center py-3">
                <div class="small mb-1" style="color: var(--mcws-text-secondary);">현재 로그인된 계정</div>
                <h4 class="fw-bold mb-2">@AuthState.CurrentUser.Username</h4>
                <div class="mb-4">
                    <span class="mcws-badge badge-running">권한: @AuthState.CurrentUser.Role</span>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn-mcws-primary w-100" @onclick='() => Nav.NavigateTo("/")'>
                        서버 대시보드로 이동
                    </button>
                    <button class="btn-mcws-danger w-100" @onclick="HandleLogoutAsync">
                        로그아웃
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 mb-4">
                <button class="@(_isLoginMode ? "btn-mcws-primary" : "btn-mcws-secondary") flex-fill"
                        @onclick="() => SwitchMode(true)">
                    로그인
                </button>
                <button class="@(!_isLoginMode ? "btn-mcws-primary" : "btn-mcws-secondary") flex-fill"
                        @onclick="() => SwitchMode(false)">
                    회원가입 신청
                </button>
            </div>

            @if (_resultCode != null)
            {
                <div class="mcws-alert @(_isError ? "mcws-alert-danger" : "mcws-alert-success")">
                    @_resultCode.Value.ToMessage()
                </div>
            }

            <div class="mb-3">
                <label class="mcws-label">아이디</label>
                <input type="text" class="mcws-input"
                       @bind="_username"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDownAsync"
                       placeholder="아이디 입력" />
            </div>

            <div class="mb-4">
                <label class="mcws-label">비밀번호</label>
                <input type="password" class="mcws-input"
                       @bind="_password"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDownAsync"
                       placeholder="비밀번호 입력" />
            </div>

            @if (_isLoginMode)
            {
                <button class="btn-mcws-primary w-100 py-2" @onclick="HandleLoginAsync">
                    로그인하기
                </button>
            }
            else
            {
                <button class="btn-mcws-primary w-100 py-2" @onclick="HandleRegisterAsync">
                    가입 신청하기
                </button>
                <div class="small mt-3 text-center" style="color: var(--mcws-text-secondary);">
                    * 최초 가입자는 <strong>Master(최고 관리자)</strong>로 즉시 등록됩니다.<br />
                    * 이후 가입자는 관리자 승인 후 로그인할 수 있습니다.
                </div>
            }
        }
    </div>
</div>

@code {
    private bool _isLoginMode = true;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private ResultCode? _resultCode;
    private bool _isError;

    protected override void OnInitialized() => AuthState.OnChange += StateHasChanged;
    public void Dispose() => AuthState.OnChange -= StateHasChanged;

    private void SwitchMode(bool loginMode)
    {
        _isLoginMode = loginMode;
        _resultCode = null;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (_isLoginMode) await HandleLoginAsync();
        else await HandleRegisterAsync();
    }

    private async Task HandleLoginAsync()
    {
        var (success, code, user) = await AuthService.ValidateLoginAsync(_username, _password);
        if (!success || user == null)
        {
            _isError = true;
            _resultCode = code;
            return;
        }

        await AuthState.LoginAsync(user);
        Nav.NavigateTo("/");
    }

    private async Task HandleRegisterAsync()
    {
        var (success, code) = await AuthService.RegisterAsync(_username, _password);
        _isError = !success;
        _resultCode = code;

        if (success)
        {
            _username = string.Empty;
            _password = string.Empty;
            _isLoginMode = true;
        }
    }

    private async Task HandleLogoutAsync()
    {
        await AuthState.LogoutAsync();
        _resultCode = null;
    }
}
