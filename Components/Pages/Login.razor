@page "/login"
@implements IDisposable
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Nav

<PageTitle>MCWS - 로그인 및 회원가입</PageTitle>

<div class="container py-5" style="max-width: 480px;">
    <div class="card border-secondary shadow-lg" style="background-color: #1a1a1e; color: #e1e1e6;">
        <div class="card-header bg-dark border-secondary text-center py-3">
            <h4 class="fw-bold mb-0" style="color: #00d26a;">MCWS 계정 센터</h4>
        </div>
        <div class="card-body p-4">
            @if (AuthState.IsLoggedIn && AuthState.CurrentUser != null)
            {
                <div class="text-center py-3">
                    <div class="mb-2 text-secondary small">현재 로그인된 계정</div>
                    <h4 class="fw-bold text-white mb-1">@AuthState.CurrentUser.Username</h4>
                    <span class="badge bg-success mb-4">권한: @AuthState.CurrentUser.Role</span>

                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-light" @onclick='() => Nav.NavigateTo("/")'>
                            서버 대시보드로 이동
                        </button>
                        <button class="btn btn-danger fw-bold" @onclick="HandleLogoutAsync">
                            로그아웃
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- 로그인 / 회원가입 전환 탭 -->
                <div class="btn-group w-100 mb-4">
                    <button class="btn @(isLoginMode ? "btn-success fw-bold" : "btn-outline-secondary")" 
                            @onclick="() => SwitchMode(true)">로그인</button>
                    <button class="btn @(!isLoginMode ? "btn-success fw-bold" : "btn-outline-secondary")" 
                            @onclick="() => SwitchMode(false)">회원가입 신청</button>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @(isError ? "alert-danger bg-dark border-danger text-danger" : "alert-info bg-dark border-info text-info") small py-2">
                        @message
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label small text-secondary">아이디</label>
                    <input type="text" class="form-control bg-black text-white border-secondary" 
                           @bind="username" 
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           placeholder="아이디 입력" />
                </div>

                <div class="mb-4">
                    <label class="form-label small text-secondary">비밀번호</label>
                    <input type="password" class="form-control bg-black text-white border-secondary" 
                           @bind="password" 
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           placeholder="비밀번호 입력" />
                </div>

                @if (isLoginMode)
                {
                    <button class="btn btn-success w-100 fw-bold py-2" @onclick="HandleLoginAsync">
                        로그인하기
                    </button>
                }
                else
                {
                    <button class="btn btn-primary w-100 fw-bold py-2" @onclick="HandleRegisterAsync">
                        가입 신청하기
                    </button>
                    <div class="text-secondary small mt-3 text-center">
                        * 최초 가입자는 <strong>Master(최고 관리자)</strong>로 즉시 등록됩니다.<br />
                        * 이후 가입자는 관리자(Master/Admin) 승인 후 로그인할 수 있습니다.
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool isLoginMode = true;
    private string username = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private bool isError = false;

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthStateChanged;
    }

    private void SwitchMode(bool loginMode)
    {
        isLoginMode = loginMode;
        message = string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (isLoginMode)
            {
                await HandleLoginAsync();
            }
            else
            {
                await HandleRegisterAsync();
            }
        }
    }

    private async Task HandleLoginAsync()
    {
        var (success, msg, user) = await AuthService.ValidateLoginAsync(username, password);
        if (!success || user == null)
        {
            isError = true;
            message = msg;
            return;
        }

        await AuthState.LoginAsync(user);
        Nav.NavigateTo("/");
    }

    private async Task HandleRegisterAsync()
    {
        var (success, msg) = await AuthService.RegisterAsync(username, password);
        isError = !success;
        message = msg;

        if (success)
        {
            username = string.Empty;
            password = string.Empty;
            isLoginMode = true;
        }
    }

    private async Task HandleLogoutAsync()
    {
        await AuthState.LogoutAsync();
        message = "로그아웃되었습니다.";
        isError = false;
    }
}
